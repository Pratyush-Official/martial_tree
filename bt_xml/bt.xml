<root main_tree_to_execute="MainTree">

    <BehaviorTree ID="MainTree">

        <Sequence name="root_sequence">

            <!-- startup delay with ROI detection -->
            <Delay name="startup_delay" delay_msec="1000">
                <RetryUntilSuccessful num_attempts="-1">
                    <Sequence name="roi_detection_retry">
                        <GetROIDetections
                            name="get_roi_detections"
                            stage="1"
                            detections="{stage1_detections}"
                        />
                    </Sequence>
                </RetryUntilSuccessful>
            </Delay>

            <YawSetpoint name="face_arena" turn="Right" current_yaw="{current_yaw}"/>

            <!-- SickPIDClient for stage1 detections -->
            <SickPIDClient
                name="sick1"
                stage1="{stage1_detections}"
                current_yaw="{current_yaw}"
                turn="{turn}"
                color="{color}"/>

            <YawSetpoint name="face_arena" turn="{turn}" current_yaw="{current_yaw}"/>

            <SickPIDClient
                name="sick1"
                stage1="{stage1_detections}"
                current_yaw="{current_yaw}"
                turn="{turn}"/>

        </Sequence>

    </BehaviorTree>

</root>

