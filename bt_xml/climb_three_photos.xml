<root BTCPP_format="4">
    <BehaviorTree ID="ClimbThreePhotos">
        <SequenceWithMemory>

            <Precondition if="climb_position_reached != 1" else="SUCCESS">
                <GoToEntrance name="after_scroll_picking" 
                    stage1="{stage1_detections}" 
                    current_yaw="{current_yaw}" 
                    turn="{turn}" 
                    color="{color}" 
                    check="{check}" 
                    first_stage_done="{first_stage_done}" 
                    climb_position_reached="{climb_position_reached}"/>
            </Precondition>

            <Delay name="delay_1" delay_msec="1000">
                <RetryUntilSuccessful num_attempts="-1">
                    <Sequence name="roi_detection_retry_1">
                        <GetROIDetections
                            name="get_roi_detections_1"
                            stage="1"
                            detections="{stage1_detections}"
                        />
                    </Sequence>
                </RetryUntilSuccessful>
            </Delay>

            <AkClient name="ak_client" up="true" down="false"/>

            <Delay name="delay_2" delay_msec="1000">
                <RetryUntilSuccessful num_attempts="-1">
                    <Sequence name="roi_detection_retry_2">
                        <GetROIDetections
                            name="get_roi_detections_2"
                            stage="1"
                            detections="{stage1_detections}"
                        />
                    </Sequence>
                </RetryUntilSuccessful>
            </Delay>

            <Delay name="delay_3" delay_msec="1000">
                <RetryUntilSuccessful num_attempts="-1">
                    <Sequence name="roi_detection_retry_3">
                        <GetROIDetections
                            name="get_roi_detections_3"
                            stage="1"
                            detections="{stage1_detections}"
                        />
                    </Sequence>
                </RetryUntilSuccessful>
            </Delay>

        </SequenceWithMemory>
    </BehaviorTree>
</root>