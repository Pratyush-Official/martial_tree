<root BTCPP_format="4">
    <BehaviorTree ID="SpearAssembly">
        <SequenceWithMemory>
            <Delay name="startup_delay" delay_msec="1000">
                <RetryUntilSuccessful num_attempts="-1">
                    <Sequence name="roi_detection_retry">
                        <GetROIDetections
                            name="get_roi_detections"
                            stage="1"
                            detections="{stage1_detections}"
                        />
                    </Sequence>
                </RetryUntilSuccessful>
            </Delay>

            <YawSetpoint name="face_spear_head" turn="{turn}" current_yaw="{current_yaw}"/>

            <OdomPIDClient name="entrance_odom_pid" setpoint="{martial_spear_head}"/> <!--Approach spear head rack, optimised for color-->

            <Precondition if="spear_assembled == 0" else="SUCCESS"> <!--Pickup and assemble spear if not done so, this works for reset too when spear was assembled-->
                <Delay name = "gripper_simulate" delay_msec="2000">
                    <AlwaysSuccess/>
                </Delay>
            </Precondition>

            <EntranceZoneDecision 
                stage1="{stage1}"
                current_yaw="{current_yaw}"
                turn="{turn}"
                color="{color}"
                climb_position_reached="{climb_position_reached}"
                pick_from_entrance="{pick_from_entrance}"
                ran_through="{ran_through}"/> <!--Decides between three setpoints on the x-axis based on camera or display input-->

            <OdomPIDClient name="entrance_odom_pid" setpoint="{entrance_movement}"/> <!--Robot goes to the decided setpoint-->

            <YawSetpoint name="face_arena" turn="{turn}" current_yaw="{current_yaw}"/> <!--Robot turns to face the forest-->

            <Precondition if="climb_position_reached == 1" else="SUCCESS"> <!--If climbing block is where the entrance_zone_decision has taken the robot-->
                <SequenceWithMemory>

                    <ReactiveSequence>
                        <VelPublish climb_state="0" next_climb_state="0"/> <!--Publish velocity until checkforprox returns success-->
                        <CheckForProx climb_state="0"/>
                    </ReactiveSequence>

                    <Precondition if="pick_from_entrance == 1" else="SUCCESS"> <!--After prox is detected, check if we need to pick up scroll-->
                        <GripperAc grip="true"/>
                    </Precondition>

                </SequenceWithMemory>
            </Precondition>

            <Precondition if="climb_position_reached == 0" else="SUCCESS"> <!--If the robot didnt go to the climbing block, the robot MUST pickup the scroll-->
                <SequenceWithMemory>
                    <StallDetection name="approach_forest" direction="Front" threshold="0.2"/> <!--Robot moves forward until stall detection-->
                    <GripperAc grip="true"/><!--After stall, gripper is actuated-->

                    <Precondition if="(under_roi == 'roi1' && color == 'red') || (under_roi == 'roi3' && color == 'blue')" else="SUCCESS"><!--If robot is at the "right" of climbing block, move to climbing block-->
                        <SequenceWithMemory>
                            <Script code="move_to_climbing_front := '[0.0, -700.0]'"/>
                            <OdomPIDClient name="entrance_odom_pid" setpoint="{move_to_climbing_front}"/>
                            <Script code="climb_position_reached:=1"/>
                        </SequenceWithMemory>                
                    </Precondition>

                    <Precondition if="(under_roi == 'roi3' && color == 'red') || (under_roi == 'roi1' && color == 'blue')" else="SUCCESS"><!--If robot is at the "left" of climbing block, move to climbing block-->
                            <SequenceWithMemory>
                                <Script code="move_to_climbing_front := '[0.0, 700.0]'"/>
                                <OdomPIDClient name="entrance_odom_pid" setpoint="{move_to_climbing_front}"/>
                                <Script code="climb_position_reached:=1"/>
                            </SequenceWithMemory>
                    </Precondition>
                </SequenceWithMemory>
            </Precondition>

            <AkClient up="true" down="false"/> <!--Perform Climb-->
            <Roll climb_state="down"/><!--Roll back-->
        </SequenceWithMemory>

    </BehaviorTree>