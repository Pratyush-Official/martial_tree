<root BTCPP_format="4">
    <BehaviorTree ID="ScrollPickFromEntrance">
        <SequenceWithMemory>
            <SickPIDClient name="before_scroll_picking" 
                stage1="{stage1_detections}" 
                current_yaw="{current_yaw}" 
                turn="{turn}" 
                color="{color}" 
                check="{check}" 
                first_stage_done="{first_stage_done}" 
                climb_position_reached="{climb_position_reached}"/>

            <YawSetpoint name="face_arena" turn="{turn}" current_yaw="{current_yaw}"/>

            <!-- </PickUpScroll> -->
        </SequenceWithMemory>
    </BehaviorTree>
</root>