<root BTCPP_format="4">
    <BehaviorTree ID="OdomScrollPickFromEntrance">
        <SequenceWithMemory>

            <DecisionSick name="1st_sick_decision" 
                stage1="{stage1_detections}"
                current_yaw="{current_yaw}"
                turn="{turn}"
                climb_position_reached="{climb_position_reached}"
                pick_from_entrance="{pick_from_entrance}"
                ran_through="{ran_through}"
                under_roi="{under_roi}"/> <!--Decides between three setpoints on the x-axis based on camera or display input-->

            <YawSetpoint name="face_arena" turn="{turn}" current_yaw="{current_yaw}"/> <!--Robot turns to face the forest-->

            <SickPIDClient name="entrance_sick_pid" setpoint="{entrance_movement}"/> <!--Robot goes to the decided setpoint-->
            
            <Precondition if="climb_position_reached == 1" else="SUCCESS"> <!--If climbing block is where the entrance_zone_decision has taken the robot-->
                <SequenceWithMemory>
                    <Parallel success_count="3" failure_count="-1">
                        <ReactiveSequence>
                            <Inverter>
                                <CheckForProx climb_state="0"/>
                            </Inverter>
                            <KeepRunningUntilFailure>
                                <VelPublish climb_state="0" next_climb_state="0"/>
                            </KeepRunningUntilFailure>
                        </ReactiveSequence>
                    
                    <Precondition if="pick_from_entrance == 1" else="SUCCESS"> <!--To parallely run the grabber if we need to grab scroll-->
                        <GripperPose angle="3.1"/> <!--Set pitch grab scroll-->
                        <GripperAct state="1.2"/>  <!--Fully Open the gripper-->
                    </Precondition>
                    </Parallel>

                    <Precondition if="pick_from_entrance == 1" else="SUCCESS"> <!--After prox is detected, check if we need to pick up scroll-->
                        <SequenceWithMemory> 
                            <GripperAct state="2.0"/> <!--Close the gripper to grab the scroll-->
                            <GripperPose angle="1.5"/> <!--Raise the scroll after grabbing-->
                            <setExtension length="0.0"/> <!--Extend the elevator to make room for storing-->
                            <GripperPose angle="0.0"/> <!--Pitch the gripper to store the scroll in the robot-->
                            <GripperAct state="0.0"/> <!--Open the gripper to drop the scroll in the robot-->
                        </SequenceWithMemory>
                    </Precondition>

                </SequenceWithMemory>
            </Precondition>

            <Precondition if="climb_position_reached == 0" else="SUCCESS"> <!--If the robot didnt go to the climbing block, the robot MUST pickup the scroll-->
                <SequenceWithMemory>
                    <StallDetection name="approach_forest" direction="Front" threshold="0.2"/> <!--Robot moves forward until stall detection-->
                    <SequenceWithMemory> 
                            <GripperPose angle="0.0"/> <!--Set pitch to slightly above wire-->
                            <GripperAct state="0.0"/>  <!--Fully Open the gripper-->
                            <setHeight height="0.0"/> <!--Raise the gripper to the height of the scroll-->
                            <GripperPose angle="0.0"/> <!--Set pitch to horizontal--> 
                            <setExtension length="0.0"/> <!--Extend the gripper to reach the scroll-->
                            <GripperAct state="0.0"/> <!--Close the gripper to grab the scroll-->
                            <GripperPose angle="0.0"/> <!--Raise the scroll after grabbing-->
                            <setExtension length="0.0"/> <!--Extend the elevator to make room for storing-->
                            <GripperPose angle="0.0"/> <!--Pitch the gripper to store the scroll in the robot-->
                            <GripperAct state="0.0"/> <!--Open the gripper to drop the scroll in the robot-->
                    </SequenceWithMemory>

                    <Precondition if="(under_roi == 'roi1' && color == 'red') || (under_roi == 'roi3' && color == 'blue')" else="SUCCESS"><!--If robot is at the "right" of climbing block, move to climbing block-->
                        <SequenceWithMemory>
                            <Script code="move_to_climbing_front := '[0.0, -700.0]'"/>
                            <OdomPIDClient name="entrance_odom_pid" setpoint="{move_to_climbing_front}"/>
                            <Script code="climb_position_reached:=1"/>
                        </SequenceWithMemory>                
                    </Precondition>

                    <Precondition if="(under_roi == 'roi3' && color == 'red') || (under_roi == 'roi1' && color == 'blue')" else="SUCCESS"><!--If robot is at the "left" of climbing block, move to climbing block-->
                            <SequenceWithMemory>
                                <Script code="move_to_climbing_front := '[0.0, 700.0]'"/>
                                <OdomPIDClient name="entrance_odom_pid" setpoint="{move_to_climbing_front}"/>
                                <Script code="climb_position_reached:=1"/>
                            </SequenceWithMemory>
                    </Precondition>
                    
                </SequenceWithMemory>
            </Precondition>
        </SequenceWithMemory>
    </BehaviorTree>
</root>