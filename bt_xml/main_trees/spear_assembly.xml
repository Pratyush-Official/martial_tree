<root BTCPP_format="4">
    <BehaviorTree ID="SpearAssembly">
        <Sequence>

            <YawSetpoint name="face_spear_head" turn="{turn}" current_yaw="{current_yaw}"/>

            <OdomPIDClient name="entrance_odom_pid" setpoint="{odom_martial_spear_head}"/> <!--Approach spear head rack, optimised for color-->

            <Precondition if="spear_assembled == 0" else="SUCCESS"> <!--Pickup and assemble spear if not done so, this works for reset too when spear was assembled-->
                <Delay name = "gripper_simulate" delay_msec="3000">
                    <SetBlackboard output_key="spear_assembled" value="1" />
                </Delay>
            </Precondition>
            <!-- <OdomPIDClient name="entrance_odom_pid" setpoint="{odom_martial_closest_entrance}"/> Remove this if using odom pick from entrance -->
        </Sequence>

    </BehaviorTree>
</root>