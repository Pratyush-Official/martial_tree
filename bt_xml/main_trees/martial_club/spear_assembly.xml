<root BTCPP_format="4">
    <BehaviorTree ID="SpearAssembly">
        <Sequence>

            <YawSetpoint name="face_spear_head" turn="{turn}" current_yaw="{current_yaw}"/>

            <OdomPIDClient name="entrance_odom_pid" setpoint="{odom_martial_spear_head}"/> <!--Approach spear head rack, optimised for color-->

            <Delay name = "gripper_simulate" delay_msec="3000">
                <SetBlackboard output_key="spear_assembled" value="1" />
            </Delay>
            
            <DecisionOdom 
                stage1="{stage1_detections}"
                current_yaw="{current_yaw}"
                turn="{turn}"
                color="{color}"/> <!--Decides between three setpoints on the x-axis based on camera or display input-->

            <OdomPIDClient name="entrance_odom_pid" setpoint="{entrance_movement_odom}"/> <!--Remove this if using odom pick from entrance-->
            <YawSetpoint name="face_forest" turn="{turn}" current_yaw="{current_yaw}"/>

        </Sequence>

    </BehaviorTree>
</root>