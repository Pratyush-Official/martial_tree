<root BTCPP_format="4">
    <BehaviorTree ID="OdomScrollPickFromEntrance">
        <SequenceWithMemory>
            <DecisionOdom 
                stage1="{stage1_detections}"
                current_yaw="{current_yaw}"
                turn="{turn}"
                color="{color}"
                climb_position_reached="{climb_position_reached}"
                pick_from_entrance="{pick_from_entrance}"
                ran_through="{ran_through}"/> <!--Decides between three setpoints on the x-axis based on camera or display input-->

            <OdomPIDClient name="entrance_odom_pid" setpoint="{entrance_movement}"/> <!--Robot goes to the decided setpoint-->

            <YawSetpoint name="face_arena" turn="{turn}" current_yaw="{current_yaw}"/> <!--Robot turns to face the forest-->

            <Precondition if="climb_position_reached == 1" else="SUCCESS"> <!--If climbing block is where the entrance_zone_decision has taken the robot-->
                <SequenceWithMemory>

                    <Precondition if="pick_from_entrance == 1" else="SUCCESS"> <!--If the robot has not already picked from the entrance, pick from the entrance-->
                        <SequenceWithMemory>
                            <GripperPose angle="3.2"/>
                            <GripperAct state="1.2"/> <!--Fully open the gripper-->
                        </SequenceWithMemory>
                    </Precondition>

                    <Parallel success_count="2" failure_count="-1">
                        <Inverter>
                            <ReactiveSequence>
                                <Inverter>
                                    <CheckForProx climb_state="0"/>
                                </Inverter>
                                <KeepRunningUntilFailure>
                                    <VelPublish climb_state="0" next_climb_state="0"/>
                                </KeepRunningUntilFailure>
                            </ReactiveSequence>
                        </Inverter>
                    </Parallel>

                    <Precondition if="pick_from_entrance == 1" else="SUCCESS"> <!--If the robot has not already picked from the entrance, pick from the entrance-->
                        <SequenceWithMemory>
                            <GripperAct state="2.0"/>
                            <Delay name="startup_delay" delay_msec="2000">
                                <AlwaysSuccess/>
                            </Delay>
                            <GripperPose angle="1.5"/>
                            <GripperAct state="1.8"/>
                        </SequenceWithMemory>
                    </Precondition>
                </SequenceWithMemory>
            </Precondition>

            <Precondition if="climb_position_reached == 0" else="SUCCESS"> <!--If the robot didnt go to the climbing block, the robot MUST pickup the scroll-->
                <SequenceWithMemory>

                    <Script code="entrance_movement_400 := '[700, 0.0]'"/>
                    <OdomPIDClient name="entrance_odom_reach_400" setpoint="{entrance_movement_400}"/> <!--Robot goes to the decided setpoint-->

                    <!-- <StallDetection name="approach_forest" direction="Front" threshold="0.2"/> Robot moves forward until stall detection -->
                    <SequenceWithMemory> 
                            <GripperPose angle="3.1"/> <!--Set pitch to slightly above wire-->
                            <GripperAct state="1.2"/>  <!--Fully Open the gripper-->
                            <setHeight height="10.0"/> <!--Raise the gripper to the height of the scroll-->
                            <setExtension length="10.0"/>
                            <GripperAct state="2.0"/> <!--Close the gripper to grab the scroll-->
                            <GripperPose angle="1.5"/> <!--Raise the scroll after grabbing-->
                            <GripperAct state="1.9"/> <!--Open the gripper to drop the scroll in the robot-->
                    </SequenceWithMemory>

                    <Precondition if="(under_roi == 'roi1' && color == 'red') || (under_roi == 'roi3' && color == 'blue')" else="SUCCESS"><!--If robot is at the "right" of climbing block, move to climbing block-->
                        <SequenceWithMemory>
                            <Script code="move_to_climbing_front := '[0.0, -700.0]'"/>
                            <OdomPIDClient name="entrance_odom_pid" setpoint="{move_to_climbing_front}"/>
                            <Script code="climb_position_reached:=1"/>
                        </SequenceWithMemory>                
                    </Precondition>

                    <Precondition if="(under_roi == 'roi3' && color == 'red') || (under_roi == 'roi1' && color == 'blue')" else="SUCCESS"><!--If robot is at the "left" of climbing block, move to climbing block-->
                            <SequenceWithMemory>
                                <Script code="move_to_climbing_front := '[0.0, 700.0]'"/>
                                <OdomPIDClient name="entrance_odom_pid" setpoint="{move_to_climbing_front}"/>
                                <Script code="climb_position_reached:=1"/>
                            </SequenceWithMemory>
                    </Precondition>
                    
                </SequenceWithMemory>
            </Precondition>

        </SequenceWithMemory>
    </BehaviorTree>
</root>