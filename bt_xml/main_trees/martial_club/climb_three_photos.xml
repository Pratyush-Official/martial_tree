                        />
                    </Sequence>
                </RetryUntilSuccessful>
            </Delay> -->
            <Inverter>
                <ReactiveSequence>
                    <Inverter>
                        <CheckForProx climb_state="0"/>
                    </Inverter>
                    <KeepRunningUntilFailure>
                        <VelPublish climb_state="0" next_climb_state="0"/>
