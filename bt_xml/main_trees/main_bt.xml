<root BTCPP_format="4">
    <BehaviorTree ID="MainTree">

        <!--<SickPIDClient SP1="1190.36" SP2="1190.0" SP3="3395.4.0" SP4="0.0"/>-->
        <!-- <OdomPIDClient name="Move" move_x= "600.0" move_y= "0.0"/> -->
        <!-- <YawSetpoint name="face_arena" turn="Right" current_yaw="{current_yaw}"/> -->
        <!-- <YawPIDClient name="Rotate" rotate_state="90.0" final_yaw="{final_yaw}"/> -->

    <!-- move this whole comment block up inside Behaviour tree block -->
    <SequenceWithMemory>
        <Delay name="startup_delay" delay_msec="1000">
            <AlwaysSuccess/>
        </Delay>
        <SequenceWithMemory>
            <InitializePortsActuators/>
            <SetpointLoader color="{color}"/>
            
            <Delay name="startup_delay" delay_msec="1000">
                <RetryUntilSuccessful num_attempts="-1">
                    <Sequence name="roi_detection_retry">
                        <GetROIDetections
                            name="get_roi_detections"
                            stage="1"
                            detections="{stage1_detections}"
                        />
                    </Sequence>
                </RetryUntilSuccessful>
            </Delay>

            <Inverter>
                <KeepRunningUntilFailure>
                    <Inverter>
                        <IfThenElse>
                            <ZoneChange/>
                            <WhileDoElse>
                                <WaitForSet/>
                                <SequenceWithMemory> <!--Should be sequence only-->

                                    <!-- <Precondition if="in_martial == 1 && (spear_assembled != 1 || photo_sequence == 1)" else="SUCCESS"> -->
                                    <SubTree ID="SpearAssembly" _autoremap="true"/>
                                    <!-- </Precondition> -->
                                    <!-- <Precondition if="spear_assembled == 1" else="RUNNING">
                                        <AlwaysSuccess/>
                                    </Precondition> -->

                                    <Precondition if="in_martial == 1 && spear_assembled == 1 && scroll_picked_from_entrance != 1" else="SUCCESS">
                                        <SubTree ID="OdomScrollPickFromEntrance" _autoremap="true"/>
                                    </Precondition>
                                    
                                    <Precondition if="scroll_picked_from_entrance == 1" else="RUNNING">
                                        <AlwaysSuccess/>
                                    </Precondition>
                                    
                                    <Precondition if="in_martial == 1 && spear_assembled == 1 && scroll_picked_from_entrance == 1 && climbed_three_photos != 1" else="SUCCESS">
                                        <SubTree ID="ClimbThreePhotos" _autoremap="true"/>
                                    </Precondition>
                                    <Precondition if="climbed_three_photos == 1" else="RUNNING">
                                         <AlwaysSuccess/>
                                    </Precondition>

                                    <Precondition if="in_forest == 1" else="SUCCESS">
                                        <!-- <SubTree ID="ForestTree"/> -->
                                        <KeepRunningUntilFailure>
                                            <AlwaysFailure/>
                                        </KeepRunningUntilFailure>
                                    </Precondition>
                                    <Precondition if="in_forest == 0" else="RUNNING">
                                        <AlwaysSuccess/>
                                    </Precondition>

                                    <KeepRunningUntilFailure>
                                        <AlwaysFailure/>
                                    </KeepRunningUntilFailure>
                                </SequenceWithMemory>
                                <AlwaysFailure/>
                            </WhileDoElse>
                            <!-- <SubTree ID="arena_reset_zone"/> -->
                            <AlwaysFailure/>
                        </IfThenElse>
                    </Inverter>
                </KeepRunningUntilFailure>
            </Inverter>
        </SequenceWithMemory>
    </SequenceWithMemory>
    </BehaviorTree>
</root> 